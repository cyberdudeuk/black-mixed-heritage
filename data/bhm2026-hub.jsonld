  },
  "@graph": [
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:hub",
      "name": "Black History Month 2026 Hub",
      "version": "2.19.1",
      "dateModified": "2026-10-21",
      "about": "Honouring Our Communities"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1507",
      "name": "John Blanke plays at the Tudor court",
      "description": "A Black trumpeter, John Blanke, is recorded in the royal accounts of Henry VII and Henry VIII. He is one of the earliest named Black people in English records.",
      "startDate": "1507",
      "keywords": "Culture and community",
      "location": {
        "@id": "urn:bhm26:westminster"
      }
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1900",
      "name": "First Pan-African Conference, London",
      "description": "Organised by the Trinidadian barrister Henry Sylvester Williams at Westminster Town Hall, it laid early foundations for organised Pan-Africanism.",
      "startDate": "1900",
      "keywords": "Politics and ideas",
      "location": {
        "@id": "urn:bhm26:westminster"
      },
      "citation": "https://www.historyworkshop.org.uk/the-fifth-pan-african-congress-75-years-on-a-landmark-moment-in-british-radical-history/"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1917",
      "name": "Walter Tull commissioned as an officer",
      "description": "The footballer Walter Tull becomes one of the first Black officers in the British Army, despite rules that barred people not of 'pure European descent'. He was killed in 1918.",
      "startDate": "1917",
      "keywords": "Public service"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1945",
      "name": "Fifth Pan-African Congress, Manchester",
      "description": "From 15 to 21 October, around 200 delegates met at Chorlton-on-Medlock Town Hall. Future leaders of Ghana, Kenya and Nigeria attended; its resolutions shaped independence movements.",
      "startDate": "1945",
      "keywords": "Politics and ideas",
      "location": {
        "@id": "urn:bhm26:manchester"
      },
      "citation": "https://tribunemag.co.uk/2022/10/fifth-pan-african-congress-manchester-chorlton-1945"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1948a",
      "name": "The Empire Windrush arrives at Tilbury",
      "description": "On 22 June, the Empire Windrush docks with passengers from the Caribbean. Many joined the new NHS, transport and other public services. Their arrival gives the Windrush generation its name.",
      "startDate": "1948",
      "keywords": "Migration and belonging",
      "location": {
        "@id": "urn:bhm26:tilbury"
      }
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1948b",
      "name": "British Nationality Act",
      "description": "Creates the status of Citizen of the United Kingdom and Colonies, under which many Caribbean and African people came to Britain as citizens.",
      "startDate": "1948",
      "keywords": "Law and policy",
      "citation": "https://www.nationalarchives.gov.uk/help-with-your-research/research-guides/black-british-social-and-political-history-in-the-20th-century/"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1959",
      "name": "Claudia Jones's Caribbean Carnival",
      "description": "The journalist and activist Claudia Jones organises an indoor Caribbean carnival at St Pancras Town Hall after the 1958 Notting Hill riots, a forerunner of today's Notting Hill Carnival.",
      "startDate": "1959",
      "keywords": "Culture and community",
      "location": {
        "@id": "urn:bhm26:nottinghill"
      }
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1963",
      "name": "Bristol Bus Boycott",
      "description": "Led by Paul Stephenson and the West Indian Development Council, a four-month boycott forces the Bristol Omnibus Company to end its refusal to employ Black and Asian crews.",
      "startDate": "1963",
      "keywords": "Civil rights",
      "location": {
        "@id": "urn:bhm26:bristol"
      },
      "citation": "https://en.wikipedia.org/wiki/Bristol_Bus_Boycott"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1965",
      "name": "Race Relations Act 1965",
      "description": "The first UK law against racial discrimination, covering public places. The Bristol campaign is widely credited with helping to bring it about.",
      "startDate": "1965",
      "keywords": "Law and policy"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1966",
      "name": "Notting Hill Carnival takes to the streets",
      "description": "A local street festival in Notting Hill grows into one of the largest street carnivals in Europe.",
      "startDate": "1966",
      "keywords": "Culture and community",
      "location": {
        "@id": "urn:bhm26:nottinghill"
      }
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1976",
      "name": "Race Relations Act 1976",
      "description": "Extends protection against discrimination and creates the Commission for Racial Equality.",
      "startDate": "1976",
      "keywords": "Law and policy"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1987a",
      "name": "The first UK Black History Month",
      "description": "Akyaaba Addai-Sebo, a Ghanaian-born special projects officer at the Greater London Council, founds Black History Month in London.",
      "startDate": "1987",
      "keywords": "Culture and community",
      "location": {
        "@id": "urn:bhm26:westminster"
      },
      "citation": "https://www.imperial.ac.uk/news/articles/admin-services/careers/2026/black-history-month-2026-honouring-our-communities/"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1987b",
      "name": "First Black MPs of the modern era",
      "description": "Diane Abbott, Paul Boateng and Bernie Grant are elected to the House of Commons at the general election.",
      "startDate": "1987",
      "keywords": "Politics and ideas",
      "location": {
        "@id": "urn:bhm26:westminster"
      },
      "citation": "https://en.wikipedia.org/wiki/1987_United_Kingdom_general_election"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1999",
      "name": "The Stephen Lawrence Inquiry report",
      "description": "The Macpherson report into the police response to the 1993 murder of Stephen Lawrence finds institutional racism and makes 70 recommendations for public bodies.",
      "startDate": "1999",
      "keywords": "Civil rights"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2000",
      "name": "Race Relations (Amendment) Act",
      "description": "Places a duty on public authorities to promote race equality, the forerunner of today's Public Sector Equality Duty.",
      "startDate": "2000",
      "keywords": "Law and policy"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2010",
      "name": "Equality Act 2010",
      "description": "Brings discrimination law together and introduces the Public Sector Equality Duty, which applies to public bodies in Great Britain.",
      "startDate": "2010",
      "keywords": "Law and policy"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2018",
      "name": "Windrush scandal; Stephen Lawrence Day announced",
      "description": "The government apologises after people of the Windrush generation are wrongly denied rights. The same month, 22 April is announced as Stephen Lawrence Day; Windrush Day on 22 June follows.",
      "startDate": "2018",
      "keywords": "Public service",
      "citation": "https://itv.com/news/2018-04-23/theresa-may-sets-out-annual-stephen-lawrence-day"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2025",
      "name": "Standing Firm in Power and Pride",
      "description": "The 2025 national theme. The Civil Service Race Champion reports ethnically diverse representation in the Civil Service rising from 10.1% in 2014 to 18%.",
      "startDate": "2025",
      "keywords": "Public service",
      "citation": "https://civilservice.blog.gov.uk/2025/10/02/black-history-month-2025-standing-firm-in-power-and-pride/"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2026",
      "name": "Honouring Our Communities",
      "description": "Black History Month UK, about 40 years after the first in 1987, asks the country to recognise the everyday contributors who sustain Black life across the UK.",
      "startDate": "2026",
      "keywords": "Culture and community",
      "citation": "https://www.york.ac.uk/about/equality/news-events/2026/black-history-month-2026/"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1845",
      "name": "Frederick Douglass speaks in Belfast",
      "description": "The formerly enslaved American abolitionist gives more than 50 speeches in Ireland in 1845–46, including in Belfast, which he visits five times. A statue in Lombard Street now marks his visits.",
      "startDate": "1845",
      "keywords": "Civil rights",
      "location": {
        "@id": "urn:bhm26:belfast"
      },
      "citation": "https://belfastmedia.com/frederick-douglass-takes-pride-of-place-in-belfast"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1881",
      "name": "Andrew Watson captains Scotland",
      "description": "Born in Demerara, British Guiana, Andrew Watson captains Scotland to a 6–1 win over England on 12 March. He is widely considered the first Black international footballer.",
      "startDate": "1881",
      "keywords": "Culture and community",
      "location": {
        "@id": "urn:bhm26:glasgow"
      },
      "citation": "https://en.wikipedia.org/wiki/Andrew_Watson_(footballer,_born_1856)"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2022",
      "name": "Wales makes these histories mandatory",
      "description": "The Curriculum for Wales requires schools to teach the histories and contributions of Black, Asian and minority ethnic people, the first UK nation to do so.",
      "startDate": "2022",
      "keywords": "Law and policy",
      "location": {
        "@id": "urn:bhm26:cardiff"
      }
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2025b",
      "name": "England's Curriculum and Assessment Review",
      "description": "The review, chaired by Professor Becky Francis, reports in November. The government accepts that teachers should be able to reflect the innate diversity of British history, including British Black and Asian history. A revised curriculum is due in 2027.",
      "startDate": "2025",
      "keywords": "Law and policy",
      "citation": "https://assets.publishing.service.gov.uk/media/690b2a4a14b040dfe82922ea/Government_response_to_the_Curriculum_and_Assessment_Review.pdf"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2026r",
      "name": "UN resolution on the transatlantic trade in enslaved Africans",
      "description": "On 25 March the UN General Assembly declares the trafficking of enslaved Africans the gravest crime against humanity and calls for reparations. 123 states vote for, 3 against and 52 abstain, including the UK. It is not binding.",
      "startDate": "2026",
      "keywords": "Politics and ideas",
      "citation": "https://www.opb.org/article/2026/03/26/un-calls-for-reparations-to-remedy-the-historical-wrongs-of-trafficking-enslaved-africans/"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e-75k",
      "name": "Engraved ochre at Blombos Cave",
      "description": "Pieces of ochre engraved with cross-hatched patterns, found in South Africa, are among the oldest known deliberate designs made by humans.",
      "startDate": "-73000",
      "keywords": "Science and invention"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e-42k",
      "name": "The Lebombo bone",
      "description": "A notched baboon fibula from the Lebombo Mountains of southern Africa, often described as one of the oldest counting tools.",
      "startDate": "-40000",
      "keywords": "Science and invention",
      "citation": "https://en.wikipedia.org/wiki/Ishango_bone"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e-20k",
      "name": "The Ishango bone",
      "description": "A bone tool from what is now the Democratic Republic of the Congo with 168 marks in three columns. Readings as a counting tool or calendar are debated.",
      "startDate": "-18000",
      "keywords": "Science and invention",
      "citation": "https://en.wikipedia.org/wiki/Ishango_bone"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1721",
      "name": "Onesimus and smallpox inoculation",
      "description": "An enslaved West African man in Boston, Onesimus, described inoculation to Cotton Mather. During the 1721 epidemic about 2% of those inoculated died, against about 14% of those infected naturally.",
      "startDate": "1721",
      "keywords": "Science and invention",
      "citation": "https://en.wikipedia.org/wiki/Onesimus_(Bostonian)"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1855",
      "name": "The Moçâmedes slave register, Angola",
      "description": "A register of late 1855 records 850 people enslaved in the Angolan port town of Moçâmedes, held by 111 owners; 19 men held 605 of them. Their labour sustained farming, orchil harvesting, street trades and fishing.",
      "startDate": "1855",
      "keywords": "Civil rights",
      "citation": "https://www.scielo.br/j/rbh/a/KTxBcTfhCsqh3rdCbGcvLgv/?lang=pt"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1923",
      "name": "Garrett Morgan's traffic signal patent",
      "description": "Morgan patents a signal with a warning phase between stop and go, giving traffic time to clear. He did not invent the first traffic signal, a common myth.",
      "startDate": "1923",
      "keywords": "Science and invention",
      "citation": "https://suiter.com/patent-of-the-week-traffic-signal"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1961",
      "name": "Portugal ends the indigenato regime",
      "description": "A decree of 6 September abolishes the statute that classed most Africans in Angola, Mozambique and Guinea as 'natives' without citizens' rights, which had underpinned forced labour.",
      "startDate": "1961",
      "keywords": "Law and policy"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1969",
      "name": "A home security system is patented",
      "description": "Marie Van Brittan Brown and Albert Brown receive a patent for a door camera, video monitor, intercom and remote lock, filed in 1966.",
      "startDate": "1969",
      "keywords": "Science and invention",
      "citation": "https://en.wikipedia.org/wiki/Marie_Van_Brittan_Brown_and_Albert_L._Brown"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1975",
      "name": "Angola, Mozambique and Cabo Verde become independent",
      "description": "After long liberation struggles, Portugal's African colonies gain independence; Angola on 11 November.",
      "startDate": "1975",
      "keywords": "Politics and ideas"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1976l",
      "name": "Jerry Lawson's cartridge games console",
      "description": "Lawson leads the team behind the Fairchild Channel F, the first home console built around swappable game cartridges, with the first pause button.",
      "startDate": "1976",
      "keywords": "Science and invention",
      "citation": "https://en.wikipedia.org/wiki/Jerry_Lawson_(engineer)"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e1981",
      "name": "The New Cross fire",
      "description": "Thirteen young Black people die after a house fire at a birthday party in New Cross, south London, on 18 January. The response led to the Black People's Day of Action in March.",
      "startDate": "1981",
      "keywords": "Civil rights"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2007",
      "name": "M-Pesa launches in Kenya",
      "description": "Mobile money by text message reaches millions without bank accounts, and becomes a model copied around the world.",
      "startDate": "2007",
      "keywords": "Science and invention"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2016",
      "name": "Drone delivery of blood in Rwanda",
      "description": "On 14 October Rwanda launches the world's first national drone delivery service, flying blood to hospitals with the company Zipline.",
      "startDate": "2016",
      "keywords": "Science and invention",
      "citation": "https://www.gavi.org/library/news/gavi-features/2016/rwanda-launches-world-s-first-national-drone-delivery-service-powered-by-zipline/"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2020w",
      "name": "Black History Cymru 365",
      "description": "Race Council Cymru extends Black History Month in Wales into a year-long programme, with Welsh Government funding.",
      "startDate": "2020",
      "keywords": "Culture and community",
      "location": {
        "@id": "urn:bhm26:cardiff"
      },
      "citation": "https://gov.wales/black-history-cymru-365-will-build-momentum-towards-wales-free-discrimination-and-inequality"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2021t",
      "name": "Theme: Proud To Be",
      "description": "The national theme invites people to share, in their own words, what they are proud to be and their pride in their heritage and culture.",
      "startDate": "2021",
      "keywords": "Culture and community",
      "citation": "https://www.creativebrief.com/bite/black-history-month-launches-proud-be-campaign"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2022t",
      "name": "Theme: Time for Change: Action Not Words",
      "description": "The theme calls for continued action, not just words, to tackle racism.",
      "startDate": "2022",
      "keywords": "Culture and community",
      "citation": "https://www.london.ac.uk/news-events/news/black-history-month-2022-time-change-action-not-words"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2023t",
      "name": "Theme: Saluting Our Sisters",
      "description": "The theme celebrates the vital role Black women have played in shaping history, inspiring change and building communities.",
      "startDate": "2023",
      "keywords": "Culture and community",
      "citation": "https://www.england.nhs.uk/north-west/nhs-north-west-bame-assembly/black-history-month-saluting-our-sisters"
    },
    {
      "@type": "Event",
      "@id": "urn:bhm26:e2024t",
      "name": "Theme: Reclaiming Narratives",
      "description": "The theme focuses on correcting historical inaccuracies and telling untold stories.",
      "startDate": "2024",
      "keywords": "Culture and community",
      "citation": "https://www.arts.ac.uk/students/stories/black-history-month-2024-remembering-the-past,-shaping-the-future"
    },
