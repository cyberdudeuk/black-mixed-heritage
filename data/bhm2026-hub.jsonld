    {
      "@type": "Quotation",
      "@id": "urn:bhm26:proverb-umuntu",
      "text": "Umuntu ngumuntu ngabantu",
      "inLanguage": "zu",
      "abstract": "A person is a person through other people.",
      "description": "We become who we are through our relationships. It is the root of the idea of Ubuntu.",
      "spatialCoverage": "isiZulu (Nguni), Southern Africa"
    },
    {
      "@type": "Quotation",
      "@id": "urn:bhm26:proverb-sankofa",
      "text": "Se wo were fi na wosankofa a yenkyi",
      "inLanguage": "tw",
      "abstract": "It is not wrong to go back for what you have forgotten.",
      "description": "Learning from the past is wisdom, not weakness. The saying behind the Sankofa symbol.",
      "spatialCoverage": "Twi (Akan), Ghana"
    },
    {
      "@type": "Quotation",
      "@id": "urn:bhm26:proverb-umoja",
      "text": "Umoja ni nguvu, utengano ni udhaifu",
      "inLanguage": "sw",
      "abstract": "Unity is strength; division is weakness.",
      "description": "Communities achieve together what nobody can alone.",
      "spatialCoverage": "Kiswahili, East Africa"
    },
    {
      "@type": "Quotation",
      "@id": "urn:bhm26:proverb-haba",
      "text": "Haba na haba hujaza kibaba",
      "inLanguage": "sw",
      "abstract": "Little by little fills the measure.",
      "description": "Small, steady contributions add up to something big.",
      "spatialCoverage": "Kiswahili, East Africa"
    },
    {
      "@type": "Quotation",
      "@id": "urn:bhm26:proverb-mtu",
      "text": "Mtu ni watu",
      "inLanguage": "sw",
      "abstract": "A person is people.",
      "description": "No one stands alone; we are made by our community.",
      "spatialCoverage": "Kiswahili, East Africa"
    },
    {
      "@type": "Quotation",
      "@id": "urn:bhm26:proverb-onye",
      "text": "Onye aghana nwanne ya",
      "inLanguage": "ig",
      "abstract": "Do not leave your brother or sister behind.",
      "description": "Look after your kin and your community. Often used as a call to solidarity.",
      "spatialCoverage": "Igbo, Nigeria"
    },
    {
      "@type": "Quotation",
      "@id": "urn:bhm26:proverb-agbajo",
      "text": "Àgbájọ ọwọ́ la fi ń sọ̀yà",
      "inLanguage": "yo",
      "abstract": "It is with joined hands that we beat our chests in pride.",
      "description": "Achievements worth celebrating are made together.",
      "spatialCoverage": "Yoruba, Nigeria and Benin"
    },
    {
      "@type": "Quotation",
      "@id": "urn:bhm26:proverb-dir",
      "text": "ድር ቢያብር አንበሳ ያስር",
      "inLanguage": "am",
      "abstract": "When spider webs unite, they can tie up a lion.",
      "description": "Small forces joined together can overcome great ones.",
      "spatialCoverage": "Amharic, Ethiopia"
    },
    {
      "@type": "Quotation",
      "@id": "urn:bhm26:proverb-nit",
      "text": "Nit, nitay garabam",
      "inLanguage": "wo",
      "abstract": "A person is the remedy of a person.",
      "description": "People heal and help each other; care is shared.",
      "spatialCoverage": "Wolof, Senegal and the Gambia"
    },
    {
      "@type": "Quotation",
      "@id": "urn:bhm26:proverb-menanpil",
      "text": "Men anpil, chay pa lou",
      "inLanguage": "ht",
      "abstract": "Many hands make the load light.",
      "description": "Teamwork makes any burden easier, from cooking to rebuilding.",
      "spatialCoverage": "Haitian Creole, Haiti"
    },
    {
      "@type": "Quotation",
      "@id": "urn:bhm26:proverb-piti",
      "text": "Piti piti, zwazo fè nich li",
      "inLanguage": "ht",
      "abstract": "Little by little, the bird builds its nest.",
      "description": "Patience and steady effort get things done.",
      "spatialCoverage": "Haitian Creole, Haiti"
    },
    {
      "@type": "Quotation",
      "@id": "urn:bhm26:proverb-coco",
      "text": "One one coco full basket",
      "inLanguage": "jam",
      "abstract": "One by one, the coconuts fill the basket.",
      "description": "Every small contribution counts.",
      "spatialCoverage": "Jamaican Patwa, Jamaica"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-0",
      "name": "Naming ceremonies",
      "description": "Many communities name a baby around a week after birth, when elders give names that carry meaning, family history or hopes. Akan families hold an 'outdooring' on the eighth day.",
      "spatialCoverage": "Across West Africa",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-1",
      "name": "Libation",
      "description": "Pouring a drink on the ground to honour the ancestors and ask their blessing at gatherings. Ask before including it; it is sacred to many.",
      "spatialCoverage": "West and Central Africa and the diaspora",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-2",
      "name": "Griots (jeliw)",
      "description": "Hereditary historians, musicians and praise singers who keep genealogies and history alive in song, often with the kora.",
      "spatialCoverage": "Mande peoples of West Africa",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-3",
      "name": "Indaba",
      "description": "A gathering of leaders to discuss important matters. The word is now used for conferences, such as the Deep Learning Indaba.",
      "spatialCoverage": "Zulu and Xhosa communities, South Africa",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-4",
      "name": "Coffee ceremony (buna)",
      "description": "Green beans are roasted, ground and brewed in a clay jebena, then served in three rounds. It is a daily way of gathering with relatives, neighbours and visitors.",
      "spatialCoverage": "Ethiopia and Eritrea",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-5",
      "name": "New Yam Festival (Iri Ji)",
      "description": "A thanksgiving for the harvest, when the first yams are offered and shared before the community eats the new crop.",
      "spatialCoverage": "Igbo communities, Nigeria",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-6",
      "name": "Homowo",
      "description": "A harvest festival whose name means 'hooting at hunger', remembering a famine overcome long ago.",
      "spatialCoverage": "Ga people, Ghana",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-7",
      "name": "Gerewol",
      "description": "A yearly gathering where young men in elaborate make-up and dress dance to be chosen by young women.",
      "spatialCoverage": "Wodaabe people, Niger and Chad",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-8",
      "name": "Carnival",
      "description": "Masquerade, steel pan, calypso and soca, with deep roots in emancipation celebrations.",
      "spatialCoverage": "Trinidad, the Caribbean and Notting Hill",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-9",
      "name": "Junkanoo and Jonkonnu",
      "description": "Street parades with costumes and drums at Christmas and New Year, begun by enslaved Africans.",
      "spatialCoverage": "The Bahamas and Jamaica",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-10",
      "name": "Crop Over",
      "description": "A festival marking the end of the sugar cane harvest, now the island's biggest celebration.",
      "spatialCoverage": "Barbados",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-11",
      "name": "Nine Night",
      "description": "Several nights of gathering after a death, ending on the ninth with songs, stories and food to send the spirit on.",
      "spatialCoverage": "Jamaica and the Caribbean diaspora in Britain",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-12",
      "name": "Kwanzaa",
      "description": "A week-long celebration from 26 December to 1 January, created in 1966, built on seven principles including Umoja (unity) and Kuumba (creativity).",
      "spatialCoverage": "United States and beyond",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:custom-13",
      "name": "Jumping the broom",
      "description": "Couples jump over a broom at their wedding, a custom remembered from slavery, when marriages were not legally recognised. Its origins are debated.",
      "spatialCoverage": "African American weddings",
      "inDefinedTermSet": "urn:bhm26:customs"
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-windrush-start",
      "claimReviewed": "Black history in Britain starts with Windrush in 1948.",
      "reviewBody": "People of African origin have been in Britain for at least 1,700 years. In the 3rd century AD a Roman unit called the Aurelian Moors was stationed at Aballava on Hadrian's Wall. A wealthy woman of likely North African descent, the 'Ivory Bangle Lady', was buried in York in the late 4th century. John Blanke was a paid royal trumpeter to Henry VII and Henry VIII from 1507 to 1512.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://cumbriacountyhistory.org.uk/background-first-recorded-african-community-britain",
        "https://yorkshiremuseum.org.uk/collections/collections-highlights/ivory-bangle-lady",
        "https://hrp.org.uk/tower-of-london/history-and-stories/john-blanke/"
      ]
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-windrush-illegal",
      "claimReviewed": "The Windrush generation came to Britain illegally, or were not British.",
      "reviewBody": "The British Nationality Act 1948 made people born in the UK and its colonies Citizens of the United Kingdom and Colonies, with the right to live here. The government's own review found the Windrush generation 'had every right to be here' and blamed the Home Office's 'institutional ignorance and thoughtlessness towards the issue of race'.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://assets.publishing.service.gov.uk/media/5e74984fd3bf7f4684279faa/6.5577_HO_Windrush_Lessons_Learned_Review_WEB_v2.pdf",
        "https://blog.nationalarchives.gov.uk/empire-windrush-70-years/"
      ]
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-no-history",
      "claimReviewed": "Africa had no written history or great civilisations before Europeans arrived.",
      "reviewBody": "Great Zimbabwe, a stone city built between 1100 and 1450, was the capital of a large state. Timbuktu was an intellectual and spiritual capital in the 15th and 16th centuries, and its libraries hold several hundred thousand manuscripts. Guinness World Records lists the University of al-Qarawiyyin in Fez, founded in 859, as the oldest higher-learning institution; its founding is traditionally credited to Fatima al-Fihri.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://whc.unesco.org/en/list/364/",
        "https://whc.unesco.org/en/list/119/",
        "https://www.guinnessworldrecords.com/world-records/oldest-university"
      ]
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-one-country",
      "claimReviewed": "Africa is one country, with one culture.",
      "reviewBody": "Africa is a continent of 54 United Nations member states (the African Union has 55 members). Estimates of the number of languages range from about 900 to 2,000, depending on how languages and dialects are counted.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://africacheck.org/fact-checks/reports/how-many-countries-africa-how-hard-can-question-be",
        "https://www.britannica.com/topic/African-languages"
      ]
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-compensation",
      "claimReviewed": "When Britain abolished slavery, the enslaved were compensated.",
      "reviewBody": "The £20 million compensation went to enslavers (‘slave-owners’ in the law of the time), not to the people they had enslaved. HM Treasury says it was about 40% of government spending in 1833. Freed people were made to work unpaid as 'apprentices' until 1838. The borrowing became part of a government loan that was only finally redeemed in 2015.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://www.nationalarchives.gov.uk/explore-the-collection/explore-by-time-period/georgians/1833-abolition-of-slavery-act-and-compensation-claims/",
        "https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/680456/FOI2018-00186_-_Slavery_Abolition_Act_1833_-_pdf_for_disclosure_log__003_.pdf",
        "https://thegazette.co.uk/all-notices/content/103864"
      ]
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-no-resistance",
      "claimReviewed": "Enslaved Africans did not resist.",
      "reviewBody": "Resistance was constant, from daily defiance to revolution. The Haitian Revolution of 1791 to 1804 created the first country founded by formerly enslaved people. Nanny led Jamaica's Maroons against the British in the 1720s and 1730s. Samuel Sharpe's rising in 1831 and 1832 drew in up to 60,000 people.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://kids.britannica.com/students/article/Haitian-Revolution/632767",
        "https://www.jis.gov.jm/information/heroes/nanny-of-the-maroons/",
        "https://thegazette.co.uk/all-notices/content/103864"
      ]
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-wars",
      "claimReviewed": "Black people did not fight for Britain in the world wars.",
      "reviewBody": "About 15,600 men served in the British West Indies Regiment in the First World War, and more than a million African troops served in the Second. In 2021 the Commonwealth War Graves Commission found that 45,000 to 54,000 casualties had been commemorated unequally, and at least 116,000, possibly 350,000, were not commemorated by name. It attributed this to 'pervasive racism'.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://www.iwm.org.uk/history/how-the-west-indies-helped-the-war-effort-in-the-first-world-war",
        "https://www.historyworkshop.org.uk/black-history/african-soldiers-in-world-war-ii/",
        "https://www.cwgc.org/non-commemoration-report/"
      ]
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-positive-action",
      "claimReviewed": "Positive action is the same as positive discrimination, and it is illegal.",
      "reviewBody": "The Equality Act 2010 allows proportionate positive action to help people who are disadvantaged, have different needs or are under-represented. In hiring or promotion, an employer may prefer someone from an under-represented group only when candidates are 'as qualified as' each other, and not as a blanket policy. Appointing someone mainly because of a protected characteristic is generally unlawful.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://www.legislation.gov.uk/ukpga/2010/15/section/158",
        "https://www.legislation.gov.uk/ukpga/2010/15/section/159"
      ]
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-hiring",
      "claimReviewed": "Discrimination in hiring is a thing of the past.",
      "reviewBody": "In a 2019 field experiment covering nearly 3,200 real UK vacancies, applicants from ethnic minority backgrounds had to send 60% more applications to get the same positive response as white British applicants with the same CVs. The researchers found discrimination against Black British and Pakistani-heritage applicants unchanged since the late 1960s and 1970s.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://www.nuffield.ox.ac.uk/news-events/news/new-csi-report-on-ethnic-minority-job-discrimination/"
      ]
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-race-biology",
      "claimReviewed": "Race is a fixed biological category.",
      "reviewBody": "There is more genetic variation within self-identified racial groups than between them, and the American Association of Biological Anthropologists states that race does not accurately represent human biological variation. Race is a social classification, and racism has real effects.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://www.genome.gov/genetics-glossary/Race",
        "https://bioanth.org/about/aaba-statement-on-race-racism/"
      ]
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-bame",
      "claimReviewed": "'BAME' is the right umbrella term.",
      "reviewBody": "Government guidance says not to use ‘BAME’ or ‘BME’. They emphasise some groups and leave others out, and can hide real differences between groups. Name specific ethnic groups wherever you can.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://www.ethnicity-facts-figures.service.gov.uk/style-guide/writing-about-ethnicity"
      ]
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-bhm-only",
      "claimReviewed": "Black History Month is only for Black people.",
      "reviewBody": "UK Black History Month began in London in October 1987, conceived by Akyaaba Addai-Sebo at the Greater London Council. It marks contributions to British society, science, economy and culture that are shared history for everyone, with events in schools, libraries, museums and workplaces open to all.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://senedd.wales/senedd-now/senedd-blog/black-history-month-this-october-marks-a-special-anniversary",
        "https://www.imperial.ac.uk/news/articles/admin-services/careers/2026/black-history-month-2026-honouring-our-communities/"
      ]
    },
    {
      "@type": "ClaimReview",
      "@id": "urn:bhm26:m-hair",
      "claimReviewed": "Afro hair is unprofessional, and banning it is fine.",
      "reviewBody": "Race is a protected characteristic, and treating someone badly because of a hairstyle linked to their race can be unlawful. In 2022 the Equality and Human Rights Commission said pupils should not be stopped from wearing natural Afro styles, and that bans without exceptions are likely to be unlawful. The Halo Code is a voluntary pledge for schools and workplaces.",
      "reviewRating": {
        "@type": "Rating",
        "alternateName": "False"
      },
      "citation": [
        "https://www.equalityhumanrights.com/media-centre/news/britains-equality-watchdog-takes-action-prevent-hair-discrimination-schools",
        "https://runnymedetrust.org/blog/challenging-hair-discrimination-in-schools"
      ]
    },
    {
