    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-0",
      "name": "Crenshaw coins intersectionality, 1989",
      "about": "What it means",
      "description": "Kimberlé Crenshaw's 1989 article in the University of Chicago Legal Forum, a Black feminist critique of anti-discrimination law, is the source usually cited for the term intersectionality.",
      "citation": [
        "https://scholarship.law.columbia.edu/faculty_scholarship/3007"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-1",
      "name": "A lens on overlapping inequalities",
      "about": "What it means",
      "description": "Crenshaw describes intersectionality as a way of seeing how different forms of inequality, such as race, gender and class, act together rather than separately.",
      "citation": [
        "https://www.law.columbia.edu/news/2017/06/kimberle-crenshaw-intersectionality&httpsredir=1&article=1052&context=uclf"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-2",
      "name": "Inequalities that operate together",
      "about": "What it means",
      "description": "In a 2020 interview, Crenshaw called intersectionality a prism for seeing how forms of inequality often operate together and make each other worse.",
      "citation": [
        "https://time.com/5786710/kimberle-crenshaw-intersectionality/"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-3",
      "name": "Combined discrimination clause never commenced",
      "about": "The law",
      "description": "Section 14 of the Equality Act 2010 would cover less favourable treatment because of a combination of two protected characteristics. legislation.gov.uk still marks it as prospective, meaning it has never been brought into force.",
      "citation": [
        "https://legislation.gov.uk/ukpga/2010/15/section/14"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-4",
      "name": "What section 14 was meant to do",
      "about": "The law",
      "description": "The official Explanatory Notes say section 14 would cover direct discrimination because of a combination of two protected characteristics. Their example is a Muslim man refused entry to a bus.",
      "citation": [
        "https://www.legislation.gov.uk/ukpga/2010/15/section/14/notes/data.htm"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-5",
      "name": "In practice: one characteristic at a time",
      "about": "The law",
      "description": "Because section 14 is not in force, a claimant such as a Black woman has to prove race or sex discrimination separately. A claim can fail if a comparator sharing one characteristic was treated the same.",
      "citation": [
        "https://www.kingsleynapley.co.uk/insights/blogs/employment-law-blog/falling-between-the-cracks-is-it-time-to-legislate-for-dual-discrimination"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-6",
      "name": "Measuring intersectionality is hard",
      "about": "Critiques",
      "description": "Sociologist Leslie McCall argued that, although intersectionality was widely accepted, there had been little discussion of how to research it. Each extra category multiplies the groups to compare.",
      "citation": [
        "https://www.ualberta.ca/institute-intersectionality-studies/media-library/intersectionality-readings/mccall-2005-the-complexity-of-intersectionality.pdf"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-7",
      "name": "UK data too thin for intersectional analysis",
      "about": "Critiques",
      "description": "A Scottish Government evidence review found that small samples in household surveys made intersectional analysis impossible. Combining all minority ethnic groups hid key issues.",
      "citation": [
        "https://gov.scot/publications/intersectional-evidence-review-minority-ethnic-womens-experiences-scotland-2024/pages/11"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-8",
      "name": "Critics see a 'hierarchy of oppression'",
      "about": "Critiques",
      "description": "Commentator Andrew Sullivan argued that intersectionality works like a religion that ranks groups by how oppressed they are and treats dissent as heresy.",
      "citation": [
        "https://hotair.com/john-s-2/2017/03/10/is-intersectionality-a-religion-n243196"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-9",
      "name": "Race commission: other factors matter more",
      "about": "Critiques",
      "description": "The 2021 Commission on Race and Ethnic Disparities concluded that geography, family, socio-economic background, culture and religion affect life chances more than racism does. It also said the system is no longer deliberately rigged.",
      "citation": [
        "https://assets.publishing.service.gov.uk/media/6062ddb1d3bf7f5ce1060aa4/20210331_-_CRED_Report_-_FINAL_-_Web_Accessible.pdf"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-10",
      "name": "Commission urges dropping 'BAME'",
      "about": "Critiques",
      "description": "The commission recommended no longer using aggregated labels such as ‘BAME’ and reporting on specific ethnic groups instead. Supporters of intersectionality also call for this kind of disaggregation.",
      "citation": [
        "https://assets.publishing.service.gov.uk/media/6062ddb1d3bf7f5ce1060aa4/20210331_-_CRED_Report_-_FINAL_-_Web_Accessible.pdf"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-11",
      "name": "Crenshaw rejects the 'pariah' reading",
      "about": "Responses",
      "description": "Crenshaw said critics distort intersectionality. In her view it is not identity politics on steroids and is not meant to make white men the new outcasts. She sees opposition as resistance to change.",
      "citation": [
        "https://time.com/5786710/kimberle-crenshaw-intersectionality/"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-12",
      "name": "UN experts reject the race commission's findings",
      "about": "Responses",
      "description": "The UN Working Group of Experts on People of African Descent rejected the commission's report. It said the report presented racist stereotypes as fact and ignored evidence of institutional racism.",
      "citation": [
        "https://news.un.org/en/node/1090032"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-13",
      "name": "High disability rate: Mixed White/Black Caribbean",
      "about": "Disability",
      "description": "Using age-standardised rates, Mixed White and Black Caribbean people were among the two groups with the highest disability rates: 22.4% in England and 26.7% in Wales.",
      "citation": [
        "https://www.ons.gov.uk/peoplepopulationandcommunity/healthandsocialcare/disability/articles/protectedcharacteristicsbydisabilitystatusenglandandwalescensus2021/latest"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-14",
      "name": "England-wide disability baseline",
      "about": "Disability",
      "description": "To compare, 17.7% of the whole population of England was disabled at Census 2021. Rates differ widely between ethnic groups, partly because of age structure.",
      "citation": [
        "https://www.ons.gov.uk/peoplepopulationandcommunity/healthandsocialcare/disability/articles/protectedcharacteristicsbydisabilitystatusenglandandwalescensus2021/latest"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-15",
      "name": "Disabled ethnic minority workers (‘BME’ in the source) face high unemployment",
      "about": "Disability",
      "description": "TUC analysis found disabled Black and minority ethnic workers had an unemployment rate of 10.3%, 3.6 times that of non-disabled white people.",
      "citation": [
        "https://www.tuc.org.uk/research-analysis/reports/disability-pay-and-employment-gaps"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-16",
      "name": "Mental Health Act detentions",
      "about": "Disability",
      "description": "Detentions under the Mental Health Act per 100,000 people: Black or Black British group against the White group, in England in the year to March 2026 (about 3.8 times).",
      "citation": [
        "https://digital.nhs.uk/data-and-information/publications/statistical/mental-health-act-statistics-annual-figures/2025-26-annual-figures/detentions-differences-between-groups-of-people"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-17",
      "name": "UK Black Pride began in 2005",
      "about": "LGBTQ+",
      "description": "UK Black Pride began in 2005 as a small gathering organised by Phyll Opoku-Gyimah (Lady Phyll) and other Black lesbian activists. Three coach-loads travelled to Southend-on-Sea.",
      "citation": [
        "https://www.ukblackpride.org.uk/history"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-18",
      "name": "Europe's largest LGBTQ+ people of colour celebration",
      "about": "LGBTQ+",
      "description": "UK Black Pride describes itself as Europe's largest celebration for LGBTQ+ people of African, Asian, Middle Eastern, Latin American and Caribbean heritage.",
      "citation": [
        "https://www.ukblackpride.org.uk/history"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-19",
      "name": "Racism inside LGBT communities",
      "about": "LGBTQ+",
      "description": "Stonewall's 2018 YouGov-based survey found that half of Black, Asian and minority ethnic LGBT people had faced discrimination within the LGBT community.",
      "citation": [
        "https://www.stonewall.org.uk/resources/lgbt-britain-home-and-communities-2018"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-20",
      "name": "Census: Mixed groups most likely LGB+",
      "about": "LGBTQ+",
      "description": "Census 2021 found people in Mixed or Multiple ethnic groups, which include Mixed White and Black Caribbean and Mixed White and Black African, were the most likely to identify as LGB+. Their younger age profile partly explains this.",
      "citation": [
        "https://www.ons.gov.uk/peoplepopulationandcommunity/culturalidentity/sexuality/articles/sexualorientationfurtherpersonalcharacteristicsenglandandwales/census2021"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-21",
      "name": "About 429,000 Black Muslims",
      "about": "Faith and belief",
      "description": "Muslim Council of Britain analysis of Census 2021 counts 429,142 Muslims of Black, African, Caribbean or Black British ethnicity in England and Wales, about 10.7% of Muslims.",
      "citation": [
        "https://mcb.org.uk/wp-content/uploads/2025/03/Census-Report-Summary-2025-.pdf"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-22",
      "name": "Black worshippers central to London churchgoing",
      "about": "Faith and belief",
      "description": "The 2012 London Church Census found that 48% of worshippers in Inner London were Black. Black people were more likely than White people to attend services (19% against 8%).",
      "citation": [
        "https://www.brin.ac.uk/?p=2773"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-23",
      "name": "National context: Christians now a minority",
      "about": "Faith and belief",
      "description": "At Census 2021, 46.2% of people in England and Wales identified as Christian and 6.5% as Muslim. Black communities are part of both faith traditions.",
      "citation": [
        "https://irr.org.uk/research/statistics/ethnicity-and-religion/"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-24",
      "name": "Mixed White/Black Caribbean: over half a million",
      "about": "Mixed heritage",
      "description": "Census 2021 counted 513,040 people (0.9%) of Mixed White and Black Caribbean ethnicity in England and Wales. It also counted 249,593 people (0.4%) of Mixed White and Black African ethnicity.",
      "citation": [
        "https://www.ethnicity-facts-figures.service.gov.uk/uk-population-by-ethnicity/national-and-regional-populations/population-of-england-and-wales/latest"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-25",
      "name": "Black population of England and Wales",
      "about": "Mixed heritage",
      "description": "Census 2021 recorded 2,409,283 Black people (4.0%) in England and Wales: 1,488,387 Black African, 623,115 Black Caribbean and 297,781 Other Black.",
      "citation": [
        "https://www.ethnicity-facts-figures.service.gov.uk/uk-population-by-ethnicity/national-and-regional-populations/population-of-england-and-wales/latest"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-26",
      "name": "Windrush: foreseeable and avoidable",
      "about": "Migration and status",
      "description": "The independent Windrush Lessons Learned Review by Wendy Williams found the scandal was foreseeable and avoidable. It made 30 recommendations to the Home Office.",
      "citation": [
        "https://assets.publishing.service.gov.uk/media/5e74984fd3bf7f4684279faa/6.5577_HO_Windrush_Lessons_Learned_Review_WEB_v2.pdf"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-27",
      "name": "Review cites institutional thoughtlessness on race",
      "about": "Migration and status",
      "description": "Williams found institutional ignorance and thoughtlessness about race and the Windrush generation's history within the Home Office.",
      "citation": [
        "https://assets.publishing.service.gov.uk/media/5e74984fd3bf7f4684279faa/6.5577_HO_Windrush_Lessons_Learned_Review_WEB_v2.pdf"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-28",
      "name": "Black households: double low-income rate",
      "about": "Class and money",
      "description": "After housing costs, 39% of Black households were in relative low income, compared with 18% of White British households (3-year average, 2021 to 2024).",
      "citation": [
        "https://www.ethnicity-facts-figures.service.gov.uk/work-pay-and-benefits/pay-and-income/people-in-low-income-households/latest/"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-29",
      "name": "Same background, higher youth unemployment",
      "about": "Class and money",
      "description": "The Social Mobility Commission found Black Caribbean and Black African young people more likely to be unemployed than White British peers from the same socio-economic background. This shows class alone does not explain the gaps.",
      "citation": [
        "https://socialmobility.independent-commission.uk/?p=935"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-30",
      "name": "Black African pupils on FSM outperform",
      "about": "Class and money",
      "description": "Among children on free school meals, those of Black African ethnicity are among the high performers at ages 5 and 11 and at GCSE. Black Caribbean pupils are among the lower performers.",
      "citation": [
        "https://socialmobility.independent-commission.uk/?p=935"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-31",
      "name": "Half of Black people live in London",
      "about": "Place and nation",
      "description": "At Census 2021, 49.3% of Black people in England and Wales lived in London. Black people made up 13.5% of London's population and 4.5% of the West Midlands.",
      "citation": [
        "https://ethnicity-facts-figures.service.gov.uk/uk-population-by-ethnicity/national-and-regional-populations/regional-ethnic-diversity/latest"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-32",
      "name": "Wales: 28,000 Black residents",
      "about": "Place and nation",
      "description": "Census 2021 counted about 28,000 Black, Black British, Black Welsh, Caribbean or African people in Wales (0.9%), compared with 4.2% (2.4 million) in England.",
      "citation": [
        "https://www.ons.gov.uk/peoplepopulationandcommunity/culturalidentity/ethnicity/bulletins/ethnicgroupenglandandwales/census2021"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-33",
      "name": "Scotland: African group among fastest growing",
      "about": "Place and nation",
      "description": "Scotland's Census 2022 recorded 1.08% of people as African, Scottish African or British African and 0.12% as Caribbean or Black. The African group was among the fastest growing since 2011.",
      "citation": [
        "https://www.gov.scot/publications/intersectional-evidence-review-minority-ethnic-womens-experiences-scotland-2024/pages/4/"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-34",
      "name": "Northern Ireland: 11,000 Black residents",
      "about": "Place and nation",
      "description": "Northern Ireland's Census 2021 recorded 11,000 Black people (0.6%). Minority ethnic groups made up 3.4% of the population.",
      "citation": [
        "https://niopa.qub.ac.uk/bitstream/NIOPA/15768/1/census-2021-main-statistics-for-northern-ireland-phase-1-statistical-bulletin-ethnic-group.pdf"
      ]
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:in-cred-reply",
      "name": "Commission says UN misrepresented it",
      "about": "Responses",
      "description": "A spokesperson for the Commission on Race and Ethnic Disparities said the UN experts had grossly misrepresented the report's findings.",
      "citation": [
        "https://amp.cnn.com/cnn/2021/04/19/uk/un-uk-race-report-intl-gbr/index.html"
      ]
    },
