    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-bhm",
      "name": "Black History Month",
      "skos:prefLabel": "Black History Month",
      "skos:definition": "An annual commemoration in October in the UK of the history, achievements and contributions of Black people in Britain. First held in London in 1987. In the US and Canada it is held in February.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-hoc",
      "name": "Honouring Our Communities",
      "skos:prefLabel": "Honouring Our Communities",
      "skos:definition": "The 2026 national theme, which asks people to recognise the everyday contributors who sustain Black life across the UK.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-windrush",
      "name": "Windrush generation",
      "skos:prefLabel": "Windrush generation",
      "skos:definition": "People who came to the UK from Caribbean countries between 1948 and 1971, named after the Empire Windrush.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-psed",
      "name": "Public Sector Equality Duty",
      "skos:prefLabel": "Public Sector Equality Duty",
      "skos:definition": "The duty in section 149 of the Equality Act 2010 for public bodies to have due regard to eliminating discrimination, advancing equality of opportunity and fostering good relations.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-racerelations",
      "name": "Race Relations Acts",
      "skos:prefLabel": "Race Relations Acts",
      "skos:definition": "UK laws of 1965, 1968 and 1976 against racial discrimination, later brought into the Equality Act 2010.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-institutional",
      "name": "Institutional racism",
      "skos:prefLabel": "Institutional racism",
      "skos:definition": "As defined in the 1999 Macpherson report: the collective failure of an organisation to provide an appropriate and professional service to people because of their colour, culture or ethnic origin.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-champion",
      "name": "Race champion",
      "skos:prefLabel": "Race champion",
      "skos:definition": "A senior leader who sponsors race equality across an organisation and works with staff networks.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-network",
      "name": "Staff network",
      "skos:prefLabel": "Staff network",
      "skos:definition": "An employee-led group that supports members and advises the organisation. Network work should be recognised in objectives and time.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-adinkra",
      "name": "Adinkra",
      "skos:prefLabel": "Adinkra",
      "skos:definition": "Visual symbols of the Akan people of Ghana and Côte d'Ivoire, each carrying a proverb or concept.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-sankofa",
      "name": "Sankofa",
      "skos:prefLabel": "Sankofa",
      "skos:definition": "An Adinkra symbol meaning, roughly, go back and fetch it: learn from the past to build the future.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-nkonsonkonson",
      "name": "Nkonsonkonson",
      "skos:prefLabel": "Nkonsonkonson",
      "skos:definition": "An Adinkra chain-link symbol of unity and human relations.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-kente",
      "name": "Kente",
      "skos:prefLabel": "Kente",
      "skos:definition": "Strip-woven cloth associated with the Asante and Ewe peoples of Ghana and Togo. Specific patterns have names and meanings.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-panafricanism",
      "name": "Pan-Africanism",
      "skos:prefLabel": "Pan-Africanism",
      "skos:definition": "A movement for the unity and self-determination of African peoples on the continent and in the diaspora.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-tokenism",
      "name": "Tokenism",
      "skos:prefLabel": "Tokenism",
      "skos:definition": "Visible gestures towards inclusion without real change, such as asking one person to represent a whole group.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-special",
      "name": "Special category data",
      "skos:prefLabel": "Special category data",
      "skos:definition": "Under UK GDPR, data revealing racial or ethnic origin needs extra protection and a lawful condition to process. Get consent and advice before publishing it.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-diaspora",
      "name": "Diaspora",
      "skos:prefLabel": "Diaspora",
      "skos:definition": "People living outside the homeland of their ancestors who keep a connection to it. The African diaspora was shaped by forced removal as well as by migration.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-maroon",
      "name": "Maroon",
      "skos:prefLabel": "Maroon",
      "skos:definition": "A person who escaped slavery and joined a free settlement, or a descendant of such communities, as in Jamaica, Suriname and Colombia.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-creole",
      "name": "Creole language",
      "skos:prefLabel": "Creole language",
      "skos:definition": "A language formed from contact between languages that becomes a community's first language, such as Haitian Creole, Jamaican Patwa or Palenquero.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-reparations",
      "name": "Reparations",
      "skos:prefLabel": "Reparations",
      "skos:definition": "Measures to repair a serious wrong. In international law they can include restitution, compensation, rehabilitation, satisfaction (such as an apology) and guarantees that it will not happen again.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-equality",
      "name": "Equality",
      "skos:prefLabel": "Equality",
      "skos:definition": "Treating people fairly and giving them the same rights and opportunities. In law, protection from discrimination.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-equity",
      "name": "Equity",
      "skos:prefLabel": "Equity",
      "skos:definition": "Giving people what they need to reach fair outcomes, which can mean different support for different people.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-inclusion",
      "name": "Inclusion",
      "skos:prefLabel": "Inclusion",
      "skos:definition": "Making sure people can take part fully and feel they belong, not only that they are present.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-accessibility",
      "name": "Accessibility",
      "skos:prefLabel": "Accessibility",
      "skos:definition": "Designing so that as many people as possible can use something, including disabled people. Public sector websites must meet WCAG accessibility standards.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-intersectionality",
      "name": "Intersectionality",
      "skos:prefLabel": "Intersectionality",
      "skos:definition": "How different parts of a person's identity, such as race, sex, disability and class, combine to shape their experience of advantage or discrimination.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-digital",
      "name": "Digital exclusion",
      "skos:prefLabel": "Digital exclusion",
      "skos:definition": "Not being able to use online services because of cost, skills, access, disability or confidence.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-psedni",
      "name": "Section 75 duty",
      "skos:prefLabel": "Section 75 duty",
      "skos:definition": "The equality duty on public authorities in Northern Ireland under section 75 of the Northern Ireland Act 1998.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-socioeconomic",
      "name": "Socio-economic duty",
      "skos:prefLabel": "Socio-economic duty",
      "skos:definition": "A duty to consider how decisions can reduce inequalities caused by socio-economic disadvantage. In force in Scotland (Fairer Scotland Duty) and Wales.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-griot",
      "name": "Griot (jeli)",
      "skos:prefLabel": "Griot (jeli)",
      "skos:definition": "A West African hereditary historian, musician and praise singer who keeps family and community history in song.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-indaba",
      "name": "Indaba",
      "skos:prefLabel": "Indaba",
      "skos:definition": "A gathering of leaders to discuss important matters, from Zulu and Xhosa tradition.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-libation",
      "name": "Libation",
      "skos:prefLabel": "Libation",
      "skos:definition": "Pouring a drink on the ground to honour ancestors at a gathering. Sacred in many communities; ask before including it.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-ubuntu",
      "name": "Ubuntu",
      "skos:prefLabel": "Ubuntu",
      "skos:definition": "A Nguni Bantu idea of shared humanity, often glossed as \"I am because we are\".",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-race",
      "name": "Race",
      "skos:prefLabel": "Race",
      "skos:definition": "A way of grouping people, mostly by appearance and supposed ancestry, that societies created. Scientists regard it as a social category, not a biological one. In UK law it is a protected characteristic that includes colour, nationality and ethnic or national origins.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-ethnicity",
      "name": "Ethnicity",
      "skos:prefLabel": "Ethnicity",
      "skos:definition": "Belonging to a group with shared ancestry, culture, language, history or nationality. It is self-defined: in UK statistics a person's ethnic group is the one they say they belong to.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-enslaved",
      "name": "Enslaved person",
      "skos:prefLabel": "Enslaved person",
      "skos:definition": "Preferred to 'slave', because it describes what was done to a person rather than defining them by it. 'Enslaver' is preferred to 'slave owner' or 'master'.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-amazigh",
      "name": "Amazigh (Imazighen)",
      "skos:prefLabel": "Amazigh (Imazighen)",
      "skos:definition": "The name the Indigenous peoples of North Africa use for themselves; often called 'Berber', a name many regard as an outsider's label.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-neet",
      "name": "NEET",
      "skos:prefLabel": "NEET",
      "skos:definition": "Not in education, employment or training. The official measure covers 16 to 24 year olds; councils in England also track 16 and 17 year olds. It describes a status, not a person.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-beet",
      "name": "BEET",
      "skos:prefLabel": "BEET",
      "skos:definition": "Being in Education, Employment or Training: the default engaged state, not tracked individually once things go well. A term used in public-sector work on young people's journeys.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-cheet",
      "name": "CHEET",
      "skos:prefLabel": "CHEET",
      "skos:definition": "Child Held in Early years, Education or Training: a child held by the state or by someone other than their parents, such as in care, custody or treatment. A term used in public-sector work on young people's journeys.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-departure-event",
      "name": "Departure event",
      "skos:prefLabel": "Departure event",
      "skos:definition": "The point where a child leaves a system, or a system stops seeing them: for example exclusion, deregistration for home education, leaving care at 18 or leaving custody.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-adultification",
      "name": "Adultification",
      "skos:prefLabel": "Adultification",
      "skos:definition": "When children, often Black children, are not given the presumption of innocence and vulnerability that childhood should bring, and are treated as older than they are.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-political-blackness",
      "name": "Political blackness",
      "skos:prefLabel": "Political blackness",
      "skos:definition": "The use of 'Black' in 1960s to 1980s Britain as a shared political identity for people of African, Caribbean and South Asian heritage organising against racism. It has since largely fallen out of use.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-negritude",
      "name": "Négritude",
      "skos:prefLabel": "Négritude",
      "skos:definition": "A literary and cultural movement begun in Paris in the 1930s by French-speaking African and Caribbean writers, affirming Black culture against colonial assimilation.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-pan-africanism",
      "name": "Pan-Africanism",
      "skos:prefLabel": "Pan-Africanism",
      "skos:definition": "The idea that people of African descent share common interests and should unite. The Fifth Pan-African Congress met in Manchester in 1945.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-hypodescent",
      "name": "Hypodescent ('one-drop rule')",
      "skos:prefLabel": "Hypodescent ('one-drop rule')",
      "skos:definition": "A custom, later written into some US laws, of classing anyone with any African ancestry as Black.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-pardo",
      "name": "Preto and pardo",
      "skos:prefLabel": "Preto and pardo",
      "skos:definition": "Census categories in Brazil: preto (Black) and pardo (brown, often of mixed heritage). Together they are often called negros.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-pardner",
      "name": "Pardner",
      "skos:prefLabel": "Pardner",
      "skos:definition": "A rotating savings scheme: members pay in together and take turns to receive the pot. Caribbean communities in Britain used it when banks shut them out.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-sixth-region",
      "name": "The diaspora as Africa's 'sixth region'",
      "skos:prefLabel": "The diaspora as Africa's 'sixth region'",
      "skos:definition": "The African Union's description of the African diaspora, alongside its five regions on the continent.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-deeia",
      "name": "DEEIA",
      "skos:prefLabel": "DEEIA",
      "skos:definition": "Diversity, equity, equality, inclusion and accessibility: five related but different ideas. See the DEEIA lens page.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-positive-action",
      "name": "Positive action",
      "skos:prefLabel": "Positive action",
      "skos:definition": "Steps the Equality Act 2010 allows to help under-represented or disadvantaged groups, such as targeted training. Positive discrimination, such as quotas, is generally unlawful.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-wres",
      "name": "WRES",
      "skos:prefLabel": "WRES",
      "skos:definition": "The NHS Workforce Race Equality Standard: indicators that compare the experience of staff from Black and minority ethnic groups with White staff in NHS trusts.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-scs",
      "name": "Senior Civil Service (SCS)",
      "skos:prefLabel": "Senior Civil Service (SCS)",
      "skos:definition": "The most senior grades of the UK civil service, from deputy director upwards.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-atrs",
      "name": "Algorithmic Transparency Recording Standard",
      "skos:prefLabel": "Algorithmic Transparency Recording Standard",
      "skos:definition": "A government standard for publishing records of the algorithmic tools public bodies use. It is mandatory for central government.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-afcfta",
      "name": "African Continental Free Trade Area (AfCFTA)",
      "skos:prefLabel": "African Continental Free Trade Area (AfCFTA)",
      "skos:definition": "A free trade area among African Union member states; trading under it began on 1 January 2021.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": [
        "DefinedTerm",
        "skos:Concept"
      ],
      "@id": "urn:bhm26:term-dcts",
      "name": "Developing Countries Trading Scheme",
      "skos:prefLabel": "Developing Countries Trading Scheme",
      "skos:definition": "The UK scheme, since 19 June 2023, giving preferential access for imports from eligible developing countries, many in Africa.",
      "inDefinedTermSet": "urn:bhm26:glossary"
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:poster-theme",
      "name": "Theme poster",
      "abstract": "Poster: the words Honouring Our Communities in large type above a chain-link Adinkra symbol of unity, with a woven band along the top."
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:poster-nominate",
      "name": "Nominate poster",
      "abstract": "Poster asking: Who holds your community together? Invites nominations of colleagues, volunteers or neighbours, over a network of connected points."
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:poster-sankofa",
      "name": "Sankofa poster",
      "abstract": "Poster with a large Sankofa heart symbol and the words: Go back and fetch it. Learn the history that made our communities, and carry it forward."
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:poster-event",
      "name": "Event poster",
      "abstract": "Event poster with a large date block, event title, time, venue and organiser, under a woven band."
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:poster-service",
      "name": "Public service poster",
      "abstract": "Poster: Public service is community service. A woven thread connects four dates: 1948 Windrush arrives, 1963 Bristol Bus Boycott, 1987 first Black History Month, 2026 Honouring Our Communities."
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:poster-beyond",
      "name": "Beyond October poster",
      "abstract": "Poster: Honour communities all year. Lists Stephen Lawrence Day 22 April, Windrush Day 22 June, Emancipation Day 1 August, and Black History Month in October."
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:poster-roots",
      "name": "Many roots poster",
      "abstract": "Poster: Many roots, one community. Africa is shown in gold with fine threads running to places of the African diaspora around the world, above the words Ubuntu, Harambee, Teranga, Sankofa, Konbit and Mutirão."
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:poster-innovation",
      "name": "Invention runs deep poster",
      "abstract": "Poster: Invention runs deep. A notched bone with tally marks, and four milestones: the Lebombo bone about 42,000 years ago, Onesimus and inoculation in 1721, a home security system patented in 1969, and mobile money in Kenya in 2007."
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:poster-food",
      "name": "Pull up a chair poster",
      "abstract": "Poster: Pull up a chair. A table of plates seen from above, labelled jollof, injera, rice and peas, couscous, muamba and akara, inviting people to a shared meal."
    },
    {
      "@type": "CreativeWork",
      "@id": "urn:bhm26:poster-remember",
      "name": "We remember poster",
      "abstract": "Poster: We remember. A single lit candle on a dark background with the words: the ancestors, the taken, the ones who fought, the ones still fighting."
    },
    {
      "@type": "Place",
      "@id": "urn:bhm26:dia-london",
      "name": "London and British cities",
      "description": "Caribbean and African communities built since the war, alongside a Black presence recorded since at least Tudor times.",
      "keywords": "Migration after empire",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 51.5,
        "longitude": -0.12
      }
    },
    {
      "@type": "Place",
      "@id": "urn:bhm26:dia-lisbon",
      "name": "Lisbon, Portugal",
      "description": "A Black presence since the 15th century; today home to communities from Angola, Cabo Verde, Guinea-Bissau, Mozambique and São Tomé and Príncipe.",
      "keywords": "Migration after empire",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 38.72,
        "longitude": -9.14
      }
    },
    {
      "@type": "Place",
      "@id": "urn:bhm26:dia-paris",
      "name": "Paris, France",
      "description": "West and Central African and Caribbean communities; the Négritude movement began here in the 1930s.",
      "keywords": "Migration after empire",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 48.86,
        "longitude": 2.35
      }
    },
    {
      "@type": "Place",
      "@id": "urn:bhm26:dia-amsterdam",
      "name": "Amsterdam, Netherlands",
      "description": "Surinamese and Caribbean communities. Keti Koti on 1 July marks the end of slavery in Suriname and the Dutch Caribbean in 1863.",
      "keywords": "Migration after empire",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 52.37,
        "longitude": 4.9
      }
    },
    {
      "@type": "Place",
      "@id": "urn:bhm26:dia-harlem",
      "name": "Harlem, New York, USA",
      "description": "Centre of the Harlem Renaissance in the 1920s and of African American and Caribbean life.",
