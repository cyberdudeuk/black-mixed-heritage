          "200": {
            "description": "What changed",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/data/openapi.json": {
      "get": {
        "operationId": "get_openapi",
        "summary": "API description",
        "description": "OpenAPI 3.1 description of the open data files as a read-only API.",
        "responses": {
          "200": {
            "description": "API description",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/data/catalog.jsonld": {
      "get": {
        "operationId": "get_catalog",
        "summary": "Data catalogue",
