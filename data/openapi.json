{
  "openapi": "3.1.0",
  "info": {
    "title": "BHM 2026 Hub open data",
    "version": "2.27.0",
    "description": "Read-only open data files published with the BHM 2026 Hub on GitHub Pages. No key or sign-in. Text is licensed under Creative Commons Attribution 4.0.",
    "license": {
      "name": "CC BY 4.0",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    }
  },
  "servers": [
    {
      "url": "https://cyberdudeuk.github.io/black-mixed-heritage"
    }
  ],
  "paths": {
    "/data/bhm2026-events.ics": {
      "get": {
        "operationId": "get_events_ics",
        "summary": "Events calendar",
        "description": "Black History Month events, observances, remembrance days and nomination deadlines; deadlines carry reminders 14 and 2 days before. Subscribe in any calendar app.",
        "responses": {
          "200": {
            "description": "Events calendar",
            "content": {
              "text/calendar": {}
            }
          }
        }
      }
    },
    "/data/bhm2026-events.json": {
      "get": {
        "operationId": "get_events",
        "summary": "Events",
        "description": "The calendar as JSON: id, start, end, title, type, where, description and the source each event was checked against.",
        "responses": {
          "200": {
            "description": "Events",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/data/bhm2026-glossary.csv": {
      "get": {
        "operationId": "get_glossary",
        "summary": "Glossary",
        "description": "Terms and plain-English definitions.",
        "responses": {
          "200": {
            "description": "Glossary",
            "content": {
              "text/csv": {}
            }
          }
        }
      }
    },
    "/data/bhm2026-hub.jsonld": {
      "get": {
        "operationId": "get_hub",
        "summary": "The hub as linked data",
        "description": "Pages, sourced points, statistics, people, organisations, places, events and glossary concepts, as Schema.org and SKOS.",
        "responses": {
          "200": {
            "description": "The hub as linked data",
            "content": {
              "application/ld+json": {}
            }
          }
        }
      }
    },
    "/data/bhm2026-sources.json": {
      "get": {
        "operationId": "get_sources",
        "summary": "Sources",
        "description": "Every source: id, title, link, the date it was last read and the date it is due to be read again.",
        "responses": {
          "200": {
            "description": "Sources",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/data/bhm2026-deadlines.json": {
      "get": {
        "operationId": "get_deadlines",
        "summary": "Nomination deadlines",
        "description": "Published award and nomination deadlines, with how to take part and the sources checked.",
        "responses": {
          "200": {
            "description": "Nomination deadlines",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/data/bhm2026-releases.atom": {
      "get": {
        "operationId": "get_releases",
        "summary": "What is new",
        "description": "The latest releases of the hub, with what changed and how it was checked.",
        "responses": {
          "200": {
            "description": "What is new",
            "content": {
              "application/atom+xml": {}
            }
          }
        }
      }
    },
    "/data/bhm2026-pages.json": {
      "get": {
        "operationId": "get_pages",
        "summary": "Pages",
        "description": "Every page of the hub: id, title, the menu it sits in, and its address.",
        "responses": {
          "200": {
            "description": "Pages",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/data/bhm2026-points.json": {
      "get": {
        "operationId": "get_points",
        "summary": "Items and sourced points",
        "description": "Every item the hub publishes: a stable key, the dataset and page it belongs to, its address, heading, text, figure, year, note, whether it is disputed, its sources, and a fingerprint used to detect changes between releases.",
        "responses": {
          "200": {
            "description": "Items and sourced points",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/data/bhm2026-changes.json": {
      "get": {
        "operationId": "get_changes",
        "summary": "What changed",
